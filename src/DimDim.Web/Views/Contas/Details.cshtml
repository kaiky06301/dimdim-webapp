@model Conta
@{
    ViewData["Title"] = "Conta " + Model.Numero;
}

<h2 class="fw-bold mb-3">Conta @Model.Agencia / @Model.Numero</h2>
<div class="dd-card p-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9"><a asp-controller="Clientes" asp-action="Details" asp-route-id="@Model.ClienteId">@Model.Cliente?.Nome</a></dd>
        <dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.Tipo</dd>
        <dt class="col-sm-3">Saldo</dt><dd class="col-sm-9">R$ @Model.Saldo.ToString("N2")</dd>
        <dt class="col-sm-3">Abertura (UTC)</dt><dd class="col-sm-9">@Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>
<a class="btn btn-link mt-3" asp-action="Index">Voltar</a>
