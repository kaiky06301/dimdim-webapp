@model Conta
@{
    ViewData["Title"] = "Abrir conta";
}

<h2 class="fw-bold mb-3">Abrir conta</h2>
<div class="dd-card p-4">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <button type="submit" class="btn btn-dd">Salvar</button>
        <a class="btn btn-link" asp-action="Index">Voltar</a>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
