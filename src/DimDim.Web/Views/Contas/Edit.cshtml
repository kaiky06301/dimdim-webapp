@model Conta
@{
    ViewData["Title"] = "Editar conta";
}

<h2 class="fw-bold mb-3">Editar conta #@Model.Id</h2>
<div class="dd-card p-4">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />
        <button type="submit" class="btn btn-dd">Salvar alterações</button>
        <a class="btn btn-link" asp-action="Index">Voltar</a>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
